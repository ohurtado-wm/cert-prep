{
  "name": "cert-prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @cert-prep/web dev",
    "build": "bun run --filter @cert-prep/web build",
    "preview": "bun run --filter @cert-prep/web preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun run --filter @cert-prep/api db:generate",
    "db:migrate": "bun run --filter @cert-prep/api db:migrate"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@cert-prep/contracts": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.123",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
