PORT=3000
DATABASE_URL=postgresql://cert_prep_app:replace_with_app_password@127.0.0.1:55432/cert_prep
DATABASE_POOL_MAX=10

POSTGRES_DB=cert_prep
POSTGRES_USER=postgres
# Generate a local admin password with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_admin_password
POSTGRES_APP_USER=cert_prep_app
POSTGRES_APP_PASSWORD=replace_with_app_password
POSTGRES_HOST_PORT=55432
# Test credentials must have CREATEDB and target only a disposable local PostgreSQL instance.
TEST_DATABASE_URL=postgresql://postgres:replace_with_admin_password@127.0.0.1:55432/cert_prep

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
GATEWAY_USERS_ME_URL=https://westmonroe-cloud.com/users/me
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
AI_REQUEST_TIMEOUT_SECONDS=60
# Set this locally. Never commit the real key.
OPENAI_API_KEY=
